# Meshtastic Mesh Visualizer - Environment Configuration
# Copy this file to .env and customize for your setup

# ============================================================================
# DATA SOURCE (Required in Docker)
# ============================================================================
# Path to mesh data file from the monitor
# Docker: /data/mesh_data.json (shared volume from mesh-monitor)
# Local development: ../meshtastic_mesh_monitor/data/mesh_data.json
MESH_DATA_FILE=/data/mesh_data.json

# ============================================================================
# FLASK APPLICATION SETTINGS
# ============================================================================
# Environment: development or production
# Use 'production' for deployments, 'development' for local work
FLASK_ENV=production

# Flask application entry point (usually auto-detected)
FLASK_APP=app.py

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Map refresh interval in seconds (data updates from file)
REFRESH_INTERVAL_SECONDS=10

# Python settings (usually auto-configured)
# PYTHONDONTWRITEBYTECODE=1
# PYTHONUNBUFFERED=1
