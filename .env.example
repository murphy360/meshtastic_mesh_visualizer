# Meshtastic Mesh Visualizer Environment Configuration
# Copy this file to .env and configure for your setup

# ===== APPLICATION SETTINGS =====
# Flask environment (production or development)
FLASK_ENV=production
FLASK_APP=app.py

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ===== MESH DATA SOURCE =====
# Path to mesh data JSON file (typically from mesh-monitor)
MESH_DATA_FILE=/data/mesh_data.json

# ===== PORT CONFIGURATION =====
# Port to run Flask web UI on
VISUALIZER_PORT=5000

# ===== CHANNEL CONFIGURATION (FOR INTEGRATIONS) =====
# Channel numbers if visualizer needs to send messages
PUBLIC_CHANNEL=0
ADMIN_CHANNEL=1
SITREP_CHANNEL=1
